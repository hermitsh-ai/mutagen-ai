  "repository": {
    "type": "git",
    "url": "https://github.com/hermitsh-ai/mutagen-ai"
  },
  "homepage": "https://github.com/hermitsh-ai/mutagen-ai",
  "bugs": {
    "url": "https://github.com/hermitsh-ai/mutagen-ai/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
